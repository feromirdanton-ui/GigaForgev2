# GigaForge environment
# Copy to .env and fill in. Never commit real credentials.

# ── M1 client (GigaChat) ──────────────────────────────────────────────────────
GF_CLIENT__AUTH_KEY=
GF_CLIENT__SCOPE=GIGACHAT_API_PERS
GF_CLIENT__BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GF_CLIENT__OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GF_CLIENT__MODEL=GigaChat
# TLS verification. `true` is the correct setting; the Sber chain has
# historically been unreliable with verification on, so the shipped default is
# `false`. Set `true` (or point GF_CLIENT__CA_BUNDLE at the Sber root) in any
# environment that handles real data.
GF_CLIENT__VERIFY_SSL=false
# GF_CLIENT__CA_BUNDLE=/etc/ssl/certs/russian_trusted_root_ca.pem
GF_CLIENT__TIMEOUT=60
GF_CLIENT__MAX_RETRIES=4
GF_CLIENT__RPM=0
GF_CLIENT__TPM=0
# Context window. Leave empty/0 to use the MEASURED per-model table
# (261 120 tokens for every public GigaChat chat model). Set a positive value
# only to pin one window for every model in this deployment.
# GF_CLIENT__MAX_CONTEXT=261120

# ── Merge stack (the GigaForge × GigaChat layer) ──────────────────────────────
# These five switches decide whether the merged stack runs at all. They are
# listed here because a deployment that copied this file used to get the legacy
# transport, linear planning, no review and the classic engine — i.e. none of
# the merge — while the README described the opposite.
#
# Provider transport.
#   auto (default)  — the official `gigachat` SDK when it is installed and a
#                     credential is present, otherwise the in-repo GigaClient.
#   gigachat-sdk    — force the official SDK; falls back with a warning.
#   giga            — force the legacy in-repo client.
#   openai          — the OpenAI-compatible adapter.
GIGAFORGE_PROVIDER=auto
#
# Planning strategy.
#   react (default) — bounded ReAct exploration, then a validated plan.
#   linear          — one-shot slice-based plan (no exploration).
#   tot             — tree-of-thought.
GIGAFORGE_PLAN_STRATEGY=react
#
# Review strategy.
#   constitutional (default) — deterministic checks, no extra model call.
#   llm                      — a model-backed reviewer.
#   none                     — no review phase.
GIGAFORGE_REVIEW_STRATEGY=constitutional
#
# ReAct engine.
#   langgraph (default when installed) — checkpointing, interrupt(), streaming.
#   classic                            — the hand-written loop.
GIGAFORGE_REACT_ENGINE=langgraph
#
# Sub-agent fan-out engine: langgraph (default when installed) or classic.
GIGAFORGE_SUBAGENT_ENGINE=langgraph
#
# Step cap for one ReAct episode.
GIGAFORGE_REACT_MAX_STEPS=24
#
# GigaChat harness profile (ported from ai-forever/deepagents-gigachat).
#   native_fs (default) | tool_agnostic | external_runtime
GIGAFORGE_HARNESS_PROFILE=native_fs
# Compact the trajectory at this fraction of the context window.
GIGAFORGE_COMPACT_AT=0.85

# ── M2 L0 index ───────────────────────────────────────────────────────────────
GF_L0__DB_PATH=.gigaforge/l0.sqlite3
GF_L0__ROOT=.

# ── M3 firewall ───────────────────────────────────────────────────────────────
GF_FIREWALL__ROOT=.
GF_FIREWALL__MAX_FIELD_CHARS=2000
GF_FIREWALL__SLICE_BUDGET_TOKENS=12000

# ── M4–M5 core ────────────────────────────────────────────────────────────────
GF_CORE__DB_PATH=.gigaforge/core.sqlite3
GF_CORE__TRACE_PATH=.gigaforge/traces/core.jsonl
GF_CORE__DEFAULT_MODEL=GigaChat
GF_CORE__CHEAP_MODEL=GigaChat
GF_CORE__STRONG_MODEL=GigaChat-Pro
GF_CORE__NODE_TIMEOUT=120
GF_CORE__FIXLOOP__MAX_ITERATIONS=3
GF_CORE__BREAKER__FAILURE_THRESHOLD=3
GF_CORE__CACHE__TTL_SECONDS=3600

# ── V2 pricing (USD per 1M tokens) ────────────────────────────────────────────
GF_CORE__PRICES__GigaChat__prompt_per_million=0.50
GF_CORE__PRICES__GigaChat__completion_per_million=1.50
GF_CORE__PRICES__GigaChat-Pro__prompt_per_million=2.50
GF_CORE__PRICES__GigaChat-Pro__completion_per_million=10.00
